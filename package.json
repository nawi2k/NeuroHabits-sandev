{
  "name": "neuro-habits",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.neurohabits.neurohabits",
    "productName": "NeuroHabits",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "styles.css",
      "app.js",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}